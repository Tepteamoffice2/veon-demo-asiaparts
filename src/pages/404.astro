---
import Base from "../layouts/Base.astro";
import "../styles/site.css";
---
<Base lang="uk" title="Сторінку не знайдено — AsiaParts" description="Такої сторінки немає. Поверніться на головну AsiaParts або подзвоніть: (095) 275 55 50.">
  <section class="notfound">
    <div class="container">
      <a class="logo" href="/" aria-label="AsiaParts, на головну"><img src="/logo-asiaparts.svg" alt="AsiaParts" width="188" height="40" /></a>
      <h1 class="sec-title">Такої сторінки немає</h1>
      <p>Поверніться на головну або подзвоніть — підберемо деталь телефоном.</p>
      <p class="notfound__actions"><a class="btn btn--primary" href="/">На головну</a> <a class="link" href="tel:+380952755550">(095) 275 55 50</a></p>
    </div>
  </section>
</Base>
